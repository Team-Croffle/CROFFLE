{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/env.d.ts", "src/**/*", "src/**/*.vue"],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"],
      "@croffledev/shared": ["../shared/src/index.ts"],
      "@croffledev/shared/*": ["../shared/src/*"]
    },
    "types": ["node"]
  },
  "references": [
    {
      "path": "../shared"
    }
  ]
}
