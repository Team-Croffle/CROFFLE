{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/renderer/src/env.d.ts", "src/renderer/src/**/*", "src/renderer/src/**/*.vue"],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@croffledev/shared": ["../../packages/shared/src/index.ts"],
      "@croffledev/shared/*": ["../../packages/shared/src/*"]
    },
    "types": ["node"]
  },
  "references": [{ "path": "../../packages/shared" }]
}
