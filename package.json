{
  "name": "@croffledev/croffle",
  "private": true,
  "version": "1.0.1",
  "description": "Croffle monorepo",
  "author": {
    "name": "Croffle Dev.",
    "email": "support@croffledev.kr"
  },
  "homepage": "https://github.com/team-croffle",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "dev": "pnpm --filter @croffledev/desktop dev",
    "start": "pnpm --filter @croffledev/desktop start",
    "build": "pnpm --filter @croffledev/desktop build",
    "build:unpack": "pnpm --filter @croffledev/desktop build:unpack",
    "build:win": "pnpm --filter @croffledev/desktop build:win",
    "build:mac": "pnpm --filter @croffledev/desktop build:mac",
    "build:linux": "pnpm --filter @croffledev/desktop build:linux"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@swc/core": "^1.15.46",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "unplugin-swc": "^1.5.9",
    "vite": "^8.1.5",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.17.0"
}
